{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node", "vitest/globals"]
  },
  "include": ["**/*.ts", "constants/job-status"],
  "exclude": ["node_modules", "**/*.test.ts", "tests"]
}
